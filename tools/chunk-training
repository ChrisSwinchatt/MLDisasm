"""Group consecutive disassembly lines into large training blocks.

Reads opcode|disasm CSV lines from stdin, groups consecutive instructions
into blocks of approximately CHUNK_BYTES bytes each, and outputs JSON Lines
with the accumulated opcode and disassembly text.

Usage: {0} [chunk_bytes] < training.csv > training.jsonl
"""

import json
import sys

CHUNK_BYTES = 4096


def emit(opcode, disasm):
    """Write one chunk as a JSON line."""
    record = {"opcode": opcode, "disasm": disasm}
    print(json.dumps(record, ensure_ascii=False))


def main():
    chunk_bytes = CHUNK_BYTES
    if len(sys.argv) > 1:
        chunk_bytes = int(sys.argv[1])

    acc_opcode = ""
    acc_disasm = ""
    total_blocks = 0
    total_lines = 0

    for line in sys.stdin:
        line = line.strip()
        if not line:
            # Blank line = binary boundary. Emit current block and reset.
            if acc_opcode:
                emit(acc_opcode, acc_disasm)
                total_blocks += 1
                acc_opcode = ""
                acc_disasm = ""
            continue

        if "|" not in line:
            continue

        opcode, disasm = line.split("|", 1)
        acc_opcode += opcode
        acc_disasm += disasm
        total_lines += 1

        if len(acc_opcode) // 2 >= chunk_bytes:
            emit(acc_opcode, acc_disasm)
            total_blocks += 1
            acc_opcode = ""
            acc_disasm = ""

    # Emit final partial block.
    if acc_opcode:
        emit(acc_opcode, acc_disasm)
        total_blocks += 1

    print(
        f"{sys.argv[0]}: {total_lines} instructions → {total_blocks} blocks "
        f"(target {chunk_bytes} bytes/block)",
        file=sys.stderr,
    )


if __name__ == "__main__":
    main()
